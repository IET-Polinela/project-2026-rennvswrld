        await page.unroute('http://103.151.63.88:8009/api/**');

        // Buat 25 laporan dummy
        const mockReports = [];
        for (let i = 1; i <= 25; i++) {
            mockReports.push({
                id: i,
                title: `Laporan Test #${i}`,
                description: `Deskripsi laporan pengujian nomor ${i}`,
                category: i % 2 === 0 ? 'INFRASTRUCTURE' : 'ENVIRONMENT',
